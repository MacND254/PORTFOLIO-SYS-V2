# ─────────────────────────────────────────────────────────────
#  Portfolio SaaS — Environment Variables
#  Copy this file to .env and fill all values before running.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── PostgreSQL (Docker Compose) ──────────────────────────────
# These are used by the postgres service AND the backend DATABASE_URL
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_secret_change_me
POSTGRES_DB=portfolio_db

# Full Prisma connection string (auto-built from above in docker-compose.yml)
# When running locally without Docker, set this manually:
DATABASE_URL=postgresql://portfolio:portfolio_secret_change_me@localhost:5432/portfolio_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production
JWT_SECRET=change_this_to_a_very_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── Multi-Tenancy ─────────────────────────────────────────────
# Base domain for generating subdomains (e.g. francis.myportfolio.com)
PLATFORM_DOMAIN=myportfolio.com
FRONTEND_URL=http://localhost:80

# ── Docker Ports (compose.override.yml) ──────────────────────
FRONTEND_PORT=80

# ── Email / SMTP (optional — for review notifications) ───────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@myportfolio.com

# ── AI / OpenAI (optional — for CV enhancement) ──────────────
AI_API_KEY=sk-your_openai_key_here
AI_MODEL=gpt-4o-mini

# ── Storage ──────────────────────────────────────────────────
# Local upload path (inside container the volume is mounted at /app/uploads)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Super Admin Seed Credentials ─────────────────────────────
# These are only used by the seed script (npm run db:seed)
SUPER_ADMIN_EMAIL=superadmin@myportfolio.com
SUPER_ADMIN_PASSWORD=ChangeMe@12345
